[Unit]
Description=WayVNC Server
After=sway.service
Requires=sway.service

[Service]
Environment="XDG_RUNTIME_DIR=/run/waydroid-wayland"
Environment="WAYLAND_DISPLAY=wayland-1"
Environment="HOME=/root"
ExecStartPre=/usr/local/bin/wait-for-wayland-socket.sh
# -C plus HOME=/root work around a wayvnc startup crash when $HOME is
# unset (see docs/DEBUGGING_AND_TESTS.md, Phase 2).
# Listens on localhost only by default; see README "Security" for EXPOSE_LAN=yes.
ExecStart=/usr/bin/wayvnc -C /etc/wayvnc/config 127.0.0.1 5900
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
