[Unit]
Description=Sway (headless, wlroots) Compositor
After=network.target

[Service]
# On utilise un répertoire runtime DÉDIÉ, pas /run/user/0 : ce dernier est
# géré par systemd-logind (user-runtime-dir@0.service), qui le REMONTE en
# tmpfs neuf à chaque (dé/re)connexion de session pour root (ex: SSH),
# effaçant au passage tout ce que Sway y aurait déjà créé (son socket
# Wayland inclus). /run/waydroid-wayland n'est sous le contrôle que de ce
# service — jamais recyclé par logind.
Environment="XDG_RUNTIME_DIR=/run/waydroid-wayland"
Environment="WAYLAND_DISPLAY=wayland-1"
Environment="HOME=/root"
# Backend headless + pas de périphériques libinput : pattern standard pour
# faire tourner un compositeur wlroots sans écran/clavier/souris physiques
# (cf. wayvnc FAQ / ArchWiki "Sway"). wayvnc fournit les entrées via les
# protocoles wlroots virtual-pointer/virtual-keyboard.
Environment="WLR_BACKENDS=headless"
Environment="WLR_LIBINPUT_NO_DEVICES=1"
ExecStartPre=/bin/mkdir -p /run/waydroid-wayland
ExecStartPre=/bin/chmod 0700 /run/waydroid-wayland
ExecStart=/usr/bin/sway --config /etc/sway/config-headless
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
