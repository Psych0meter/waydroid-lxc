[Unit]
Description=noVNC Web Interface
After=wayvnc.service
Requires=wayvnc.service

[Service]
# Par défaut, n'écoute que sur localhost: voir README (section Sécurité)
# pour l'exposer sur le LAN via EXPOSE_LAN=yes lors de l'installation.
ExecStart=/usr/bin/websockify --web=/usr/share/novnc/ 127.0.0.1:6080 127.0.0.1:5900
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
