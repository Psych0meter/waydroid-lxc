# Configuration Sway minimale pour une session HEADLESS servant uniquement
# de compositeur wlroots à wayvnc + Waydroid (pas d'usage interactif local,
# pas de terminal, pas de barre). Volontairement dépourvue des bindsym par
# défaut de Sway (mod+Return, mod+d, ...) pour ne pas intercepter les
# entrées destinées à l'UI Android relayées via wayvnc.
#
# Résolution alignée sur le portrait Android habituel (cf. ancien weston.ini).
output * resolution 720x1280

# Waydroid communique avec le compositeur via son extension Wayland dédiée,
# pas par Xwayland : on le désactive pour économiser des ressources.
xwayland disable

bar {
    mode invisible
}
