# Pixel 7 Pro (cheetah)
# Android 16 (BP4A.250605.009) - identity fields only, adapted from yubunus/DeviceSpoofLab-Hooks.
#
# That upstream project is an LSPosed module that spoofs identifiers at
# the app layer via runtime hooks - a different mechanism entirely from
# this repo's waydroid_base.prop injection (see device-profiles/README.md).
# Its config file is much larger than this and includes hardware/HAL,
# CPU/GPU, security-state, and dozens of other non-Android-property keys
# that must NOT be appended to waydroid_base.prop: several (ro.hardware,
# ro.boot.hardware, ro.hardware.vulkan/gralloc/power/egl, ro.board.platform)
# override the values Waydroid's own image depends on to find its binder
# HAL modules, which is what broke 'waydroidplatform' (init looped on
# "Failed to get service waydroidplatform, trying again..." forever) the
# first time this profile was vendored verbatim. ro.adb.secure=1 would
# also silently re-lock headless adb (undoing enable-adb.sh). Only the
# same key set as pixel-5.prop is used here for exactly that reason -
# verify against a real device before relying on it.
ro.product.brand=google
ro.product.manufacturer=Google
ro.system.build.product=cheetah
ro.product.name=cheetah
ro.product.device=cheetah
ro.product.model=Pixel 7 Pro
ro.system.build.flavor=cheetah-user
ro.build.fingerprint=google/cheetah/cheetah:16/BP4A.250605.009/12621605:user/release-keys
ro.system.build.description=cheetah-user 16 BP4A.250605.009 12621605 release-keys
ro.bootimage.build.fingerprint=google/cheetah/cheetah:16/BP4A.250605.009/12621605:user/release-keys
ro.build.display.id=google/cheetah/cheetah:16/BP4A.250605.009/12621605:user/release-keys
ro.build.tags=release-keys
ro.build.description=cheetah-user 16 BP4A.250605.009 12621605 release-keys
ro.vendor.build.fingerprint=google/cheetah/cheetah:16/BP4A.250605.009/12621605:user/release-keys
ro.vendor.build.id=BP4A.250605.009
ro.vendor.build.tags=release-keys
ro.vendor.build.type=user
ro.odm.build.tags=release-keys
