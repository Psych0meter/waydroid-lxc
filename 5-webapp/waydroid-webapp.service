[Unit]
Description=Waydroid control webapp (GPS mock-location API)
After=network.target waydroid-session.service

[Service]
Type=simple
WorkingDirectory=__APP_DIR__
EnvironmentFile=-/etc/waydroid-webapp/webapp.env
ExecStart=__VENV_DIR__/bin/gunicorn --chdir __APP_DIR__ -w 2 -b ${WEBAPP_HOST}:${WEBAPP_PORT} app:app
Restart=on-failure
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
